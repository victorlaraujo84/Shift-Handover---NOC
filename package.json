{
  "name": "noc-telco-handover",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env server.ts",
    "check": "tsc --noEmit",
    "build": "vite build",
    "smoke": "node --import tsx scripts/smoke.mjs",
    "test:chatwoot": "node scripts/chatwoot.mjs",
    "start": "tsx --env-file-if-exists=.env server.ts --built"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.15",
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "vite": "^7.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.0"
  }
}
