PORT=3000
# Opcional para o piloto local. Sem URL, o app usa PostgreSQL embarcado (PGlite).
DATABASE_URL=
# Segredo do servidor. Deixe vazio para testar o fluxo sem Teams.
TEAMS_WEBHOOK_URL=
PUBLIC_BASE_URL=http://localhost:3000
# Exemplo para o piloto. Ajuste para a tolerância acordada pela equipe.
ACCEPTANCE_GRACE_MINUTES=15

# Arquivo local com clientes, destinos e escala. Veja handover.config.example.json.
HANDOVER_CONFIG_FILE=
# Para uso compartilhado, use proxy com SSO, PostgreSQL externo e URL pública HTTPS.
HANDOVER_AUTH_MODE=
HANDOVER_PROXY_TOKEN=

# Jira. Cloud usa e-mail e token. Data Center usa apenas PAT.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECTS=

# ID da extensão instalada no navegador. Configurado no build da interface.
VITE_CHATWOOT_EXTENSION_ID=
