{
  "manifest_version": 3,
  "name": "NOC Telco — Chatwoot",
  "version": "0.1.0",
  "permissions": ["scripting"],
  "host_permissions": ["https://app.chatwoot.com/*"],
  "externally_connectable": { "matches": ["http://127.0.0.1/*", "http://localhost/*"] },
  "background": { "service_worker": "worker.js" }
}
